{
  "name": "youtube-search-ui",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api,worker -c blue,green,magenta \"pnpm --filter web dev\" \"pnpm --filter api dev\" \"pnpm --filter api worker\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up --build -d"
  }
}
